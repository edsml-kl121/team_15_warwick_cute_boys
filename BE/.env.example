# Local demo. Copy to .env in BE/ and run the backend from that directory.
API_TOKEN=local-zippy
FRONTEND_ORIGIN=http://localhost:3000
SHOPEE_MCP_URL=http://localhost:8090/mcp
# Required. Set MONGO_URL with private database access before starting the backend.
MONGO_URL=
MONGO_DATABASE=zippy
# Optional: pin the clock for a rehearsal, e.g. 2026-11-21T07:02:00+07:00. Empty uses the real Bangkok time.
DEMO_NOW=
HOST=127.0.0.1
PORT=8080

# Optional. Enables OpenAI-powered chat. Meal photos and live calls also use it.
OPENAI_API_KEY=
# Chat model. Defaults: gpt-6.1-sol on the ultrafast tier with reasoning low (its lowest).
# For the standard tier set CHAT_SERVICE_TIER=default. For gpt-5.6-luna also set CHAT_REASONING_EFFORT=none.
CHAT_MODEL=gpt-6.1-sol
CHAT_SERVICE_TIER=ultrafast
CHAT_REASONING_EFFORT=low

# Optional. One vision model handles each meal scan.
FOOD_SCAN_MODEL=gpt-4.1-mini

# Optional. Model used by the presenter recommendation agents when OPENAI_API_KEY is set.
RECOMMENDATION_MODEL=gpt-4.1-mini
# Optional separate bucket for signing catalog images.
RECOMMENDATION_BUCKET=

# Optional meal photo storage.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set this too when using temporary AWS credentials.
AWS_SESSION_TOKEN=

# Simulated calls are the default. For live calls, use verified team test numbers.
LIVE_CALLS=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=
# Comma-separated E.164 numbers. The simulator listings must match.
TWILIO_VERIFIED_TEST_NUMBERS=
RING_TIMEOUT_SECONDS=40
MAX_CALL_SECONDS=300
CALL_LANGUAGE=English
TRANSCRIPTION_LANGUAGES=en
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=

# Web push. Generate a pair once with `uv run python -m push` and keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# Presenter dashboard key for triggering moments on a guest by name. Required on Railway.
PRESENTER_KEY=local-presenter
