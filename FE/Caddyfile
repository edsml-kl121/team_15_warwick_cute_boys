{
	admin off
}

http://:{$PORT:3000} {
	rewrite /presentor.html /presenter.html
	@zippy_api path /api/visitor /api/voice /api/sessions /api/sessions/* /api/chat /api/feed /api/profile /api/persona /api/today /api/food-log /api/food-log/photo /api/food-log/catalog-image /api/actions/buy /api/actions/pay /api/actions/cancel /api/shopee-orders/* /api/bookings/* /api/demo/trigger /api/demo/reset /api/presenter/* /api/push/* /api/recommendations/*
	handle @zippy_api {
		header >Cache-Control "no-store"
		uri strip_prefix /api
		reverse_proxy {$BACKEND_URL:http://backend:8000} {
			header_up Authorization "Bearer {$API_TOKEN:local-zippy}"
		}
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		# Revalidate on every load so a deploy never mixes new HTML with cached old CSS or JS.
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}
}
