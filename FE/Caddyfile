{
	admin off
}

http://:{$PORT:3000} {
	@zippy_api path /api/chat /api/feed /api/actions/buy /api/actions/pay /api/actions/cancel /api/shopee-orders/* /api/food-log/photo
	handle @zippy_api {
		uri strip_prefix /api
		reverse_proxy {$BACKEND_URL:http://backend:8000} {
			header_up Authorization "Bearer {$API_TOKEN:local-zippy}"
		}
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv
		file_server
	}
}
